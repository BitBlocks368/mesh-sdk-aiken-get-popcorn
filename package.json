{
  "name": "get-popcorn-workspace",
  "version": "1.0.0",
  "description": "A blockchain-enabled popcorn game built with Aiken and MeshJS",
  "private": true,
  "workspaces": [
    "packages/*",
    "mesh"
  ],
  "scripts": {
    "aiken": "cd aiken-workspace && aiken check && aiken build",
    "dev:game": "npm run dev --workspace=packages/game",
    "dev:contracts": "npm run dev --workspace=mesh",
    "build:all": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:contracts": "npm run build --workspace=packages/contracts",
    "build:game": "npm run build --workspace=packages/game",
    "test:all": "npm run test --workspaces",
    "install:all": "npm install --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeshJS/mesh-aiken-template.git"
  },
  "keywords": [
    "Mesh",
    "Cardano",
    "Aiken",
    "Game",
    "Blockchain"
  ],
  "author": "Mesh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MeshJS/mesh-aiken-template/issues"
  },
  "homepage": "https://github.com/MeshJS/mesh-aiken-template#readme",
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}